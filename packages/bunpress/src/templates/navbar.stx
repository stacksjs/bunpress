<header class="BPNav">
  <div class="BPNavBar">
    <div class="BPNavBarStart">
      {!! hamburger !!}
      <a href="/" class="BPNavBarTitle">{!! logo !!}<span class="BPNavBarTitle-text">{{ title }}</span></a>
      {!! searchTrigger !!}
    </div>

    <div class="BPNavBarEnd">
      <div class="BPNavBarMenu">
        {!! nav !!}
      </div>
      <div class="BPSocialLinks">
        <button class="theme-toggle" type="button" onclick="toggleTheme()" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
          <svg class="moon-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
        </button>
        {!! localeSwitcher !!}
        {!! socialLinks !!}
      </div>
    </div>
  </div>
</header>

<style>
/* The brand is a logo, a wordmark, or both. */
.BPNavBarTitle {
  display: flex;
  align-items: center;
  gap: 8px;
}

.BPNavBarTitle-logo {
  height: 24px;
  width: auto;
  flex-shrink: 0;
}

.BPNavBarTitle-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
</style>
