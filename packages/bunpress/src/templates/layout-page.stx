<!DOCTYPE html>
<html lang="en" class="{{ htmlClass }}" data-theme-mode="{{ themeMode }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  {!! meta !!}
  <style>
    /* VitePress Theme CSS */
    {!! customCSS !!}
  </style>
</head>
<body>
  <div class="Layout">
    <!-- BPNav - Header -->
    {!! navbar !!}

    <!-- BPContent - Full-width content without sidebar -->
    <main class="BPContent BPContent--page">
      <div class="BPPage">
        <article class="bp-doc">
          {!! content !!}
        </article>
      </div>
    </main>
  </div>

  <!-- Search overlay -->
  {!! search !!}
</body>
</html>
