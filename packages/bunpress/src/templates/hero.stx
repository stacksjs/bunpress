<style>
/* Spacing only — clearing the fixed nav is .BPHome's job. */
.BPHomeHero {
  position: relative;
  padding: 24px 20px 40px;
}

@media (min-width: 640px) {
  .BPHomeHero {
    padding: 40px 24px 56px;
  }
}

.hero-container {
  max-width: 1152px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.hero-content {
  max-width: 780px;
}

.hero-image {
  margin-top: 32px;
}

.hero-image img {
  max-width: 200px;
  height: auto;
}

/* A code panel is a full column, not a logo slot: it stacks under the copy on
 * narrow screens and takes the right half from 960px up. min-width:0 is what
 * lets its own <pre> scroll instead of stretching the flex row. */
.hero-container > .BPHeroCode {
  margin-top: 32px;
  min-width: 0;
  width: 100%;
}

@media (min-width: 960px) {
  .BPHomeHero {
    padding: 56px 64px 72px;
  }

  .hero-container {
    flex-direction: row;
    align-items: center;
    text-align: left;
    gap: 64px;
  }

  .hero-content {
    flex: 1;
  }

  .hero-image {
    margin-top: 0;
    flex-shrink: 0;
  }

  .hero-image img {
    max-width: 280px;
  }

  .hero-container > .BPHeroCode {
    margin-top: 0;
    flex: 0 1 46%;
  }

  /* Without a visual the copy is the whole hero, so it keeps its measure
   * rather than running the full 1152px. */
  .hero-container > .hero-content:only-child {
    max-width: 780px;
  }
}
</style>
