<div class="BPSearch" id="bp-search" hidden>
  <div class="BPSearch-backdrop" data-bp-search-close></div>
  <div class="BPSearch-panel" role="dialog" aria-modal="true" aria-label="Search documentation">
    <div class="BPSearch-inputRow">
      <svg class="BPSearch-inputIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="search"
        class="BPSearch-input"
        id="bp-search-input"
        placeholder="Search documentation"
        aria-label="Search documentation"
        aria-controls="bp-search-results"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <button class="BPSearch-cancel" type="button" data-bp-search-close>Esc</button>
    </div>
    <div class="BPSearch-results" id="bp-search-results" role="listbox" aria-label="Search results"></div>
    <div class="BPSearch-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
      <span><kbd>↵</kbd> to select</span>
      <span><kbd>esc</kbd> to close</span>
    </div>
  </div>
</div>

<style>
.BPSearch {
  position: fixed;
  inset: 0;
  z-index: var(--bp-z-index-search, 200);
  display: flex;
  justify-content: center;
  /* Anchored near the top rather than centred: the results list grows
     downward, and a centred panel would jump as it does. */
  align-items: flex-start;
  padding: 12vh 16px 16px;
}

.BPSearch[hidden] {
  display: none;
}

.BPSearch-backdrop {
  position: absolute;
  inset: 0;
  background-color: rgba(15, 15, 17, 0.55);
  backdrop-filter: blur(2px);
}

.BPSearch-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640px;
  max-height: 100%;
  overflow: hidden;
  background-color: var(--bp-c-bg);
  border: 1px solid var(--bp-c-divider);
  border-radius: 12px;
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.24);
}

.BPSearch-inputRow {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--bp-c-divider);
}

.BPSearch-inputIcon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: var(--bp-c-text-3);
}

.BPSearch-input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  outline: none;
  font-family: inherit;
  font-size: 16px;
  color: var(--bp-c-text-1);
}

.BPSearch-input::placeholder {
  color: var(--bp-c-text-3);
}

/* The type=search clear affordance differs per engine and collides with the
   Esc button; the Esc button is the documented way out. */
.BPSearch-input::-webkit-search-cancel-button {
  -webkit-appearance: none;
  appearance: none;
}

.BPSearch-cancel {
  flex-shrink: 0;
  padding: 3px 7px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  color: var(--bp-c-text-3);
  background-color: var(--bp-c-bg-soft);
  border: 1px solid var(--bp-c-divider);
  border-radius: 5px;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s;
}

.BPSearch-cancel:hover {
  color: var(--bp-c-text-1);
  border-color: var(--bp-c-text-3);
}

.BPSearch-results {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 8px;
}

.BPSearch-results:empty {
  display: none;
}

.BPSearch-hit {
  display: block;
  padding: 10px 12px;
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
  border: 1px solid transparent;
}

.BPSearch-hit + .BPSearch-hit {
  margin-top: 2px;
}

.BPSearch-hit:hover,
.BPSearch-hit.is-active {
  background-color: var(--bp-c-default-soft, var(--bp-c-gray-soft));
  border-color: var(--bp-c-divider);
}

.BPSearch-hit-breadcrumb {
  display: block;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--bp-c-text-3);
  margin-bottom: 2px;
}

.BPSearch-hit-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--bp-c-text-1);
  line-height: 1.4;
}

.BPSearch-hit-text {
  /* Two lines of preview: enough to judge relevance, not enough to turn the
     list into a wall of prose. */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 2px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--bp-c-text-2);
}

.BPSearch-hit mark {
  padding: 0;
  background: transparent;
  color: var(--bp-c-brand-1);
  font-weight: 700;
}

.BPSearch-empty {
  padding: 28px 16px;
  text-align: center;
  font-size: 14px;
  color: var(--bp-c-text-2);
}

.BPSearch-empty strong {
  color: var(--bp-c-text-1);
  overflow-wrap: anywhere;
}

.BPSearch-footer {
  display: flex;
  gap: 16px;
  padding: 8px 14px;
  border-top: 1px solid var(--bp-c-divider);
  background-color: var(--bp-c-bg-soft);
  font-size: 11px;
  color: var(--bp-c-text-3);
}

.BPSearch-footer kbd {
  display: inline-block;
  min-width: 16px;
  margin-right: 3px;
  padding: 1px 4px;
  font-family: inherit;
  font-size: 10px;
  text-align: center;
  color: var(--bp-c-text-2);
  background-color: var(--bp-c-bg);
  border: 1px solid var(--bp-c-divider);
  border-radius: 4px;
}

/* Phones: a centred card wastes the screen and fights the keyboard. */
@media (max-width: 639px) {
  .BPSearch {
    padding: 0;
  }

  .BPSearch-panel {
    max-width: none;
    height: 100%;
    max-height: none;
    border: none;
    border-radius: 0;
  }

  .BPSearch-footer {
    display: none;
  }
}
</style>

<script>
(function () {
  if (window.__bpSearchBound) return;
  window.__bpSearchBound = true;

  var INDEX_URL = '{{ indexUrl }}';
  var MAX_RESULTS = 12;

  var indexPromise = null;
  var records = [];
  var activeIndex = 0;
  var lastFocused = null;

  function el(id) { return document.getElementById(id); }
  function root() { return el('bp-search'); }

  function loadIndex() {
    if (indexPromise) return indexPromise;
    indexPromise = fetch(INDEX_URL)
      .then(function (res) { return res.ok ? res.json() : []; })
      .then(function (data) { records = Array.isArray(data) ? data : []; return records; })
      .catch(function () { records = []; return records; });
    return indexPromise;
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escapeRegExp(value) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  // Mark every query term inside an already-escaped string.
  function highlight(escaped, terms) {
    if (!terms.length) return escaped;
    var pattern = new RegExp('(' + terms.map(escapeRegExp).join('|') + ')', 'gi');
    return escaped.replace(pattern, '<mark>$1</mark>');
  }

  // Centre the preview on the first match instead of always showing the
  // opening words, which for a long section rarely contain the query.
  function snippet(text, terms) {
    if (!text) return '';
    var lower = text.toLowerCase();
    var at = -1;
    for (var i = 0; i < terms.length; i++) {
      var found = lower.indexOf(terms[i]);
      if (found !== -1 && (at === -1 || found < at)) at = found;
    }
    if (at <= 60) return text.slice(0, 180);
    var start = Math.max(0, at - 60);
    return '…' + text.slice(start, start + 180);
  }

  function score(record, terms) {
    var title = record.title.toLowerCase();
    var page = record.page.toLowerCase();
    var text = record.text.toLowerCase();
    var total = 0;

    for (var i = 0; i < terms.length; i++) {
      var term = terms[i];
      // Every term must appear somewhere, so a two-word query narrows
      // rather than widens the result set.
      if (title.indexOf(term) === -1 && page.indexOf(term) === -1 && text.indexOf(term) === -1) {
        return 0;
      }
      if (title === term) total += 120;
      else if (title.indexOf(term) === 0) total += 60;
      else if (title.indexOf(term) !== -1) total += 40;
      if (page.indexOf(term) !== -1) total += 8;
      if (text.indexOf(term) !== -1) total += 4;
    }

    // Shallower headings are more general destinations, so break ties toward
    // them rather than toward a deeply nested subsection.
    return total + Math.max(0, 6 - record.level);
  }

  function search(query) {
    var terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    if (!terms.length) return [];

    var hits = [];
    for (var i = 0; i < records.length; i++) {
      var value = score(records[i], terms);
      if (value > 0) hits.push({ record: records[i], score: value });
    }

    hits.sort(function (a, b) { return b.score - a.score; });
    return hits.slice(0, MAX_RESULTS).map(function (hit) { return hit.record; });
  }

  function render(query, hits) {
    var results = el('bp-search-results');
    if (!results) return;

    if (!query) {
      results.innerHTML = '';
      return;
    }

    if (!hits.length) {
      results.innerHTML = '<p class="BPSearch-empty">No results for <strong>' + escapeHtml(query) + '</strong></p>';
      return;
    }

    var terms = query.toLowerCase().split(/\s+/).filter(Boolean);
    results.innerHTML = hits.map(function (hit, i) {
      var breadcrumb = hit.title === hit.page ? '' :
        '<span class="BPSearch-hit-breadcrumb">' + escapeHtml(hit.page) + '</span>';
      var text = snippet(hit.text, terms);
      return '<a class="BPSearch-hit' + (i === 0 ? ' is-active' : '') + '" role="option"' +
        ' aria-selected="' + (i === 0 ? 'true' : 'false') + '" href="' + escapeHtml(hit.url) + '">' +
        breadcrumb +
        '<span class="BPSearch-hit-title">' + highlight(escapeHtml(hit.title), terms) + '</span>' +
        (text ? '<span class="BPSearch-hit-text">' + highlight(escapeHtml(text), terms) + '</span>' : '') +
        '</a>';
    }).join('');
    activeIndex = 0;
  }

  function hits() { return Array.prototype.slice.call(document.querySelectorAll('.BPSearch-hit')); }

  function setActive(next) {
    var list = hits();
    if (!list.length) return;
    activeIndex = (next + list.length) % list.length;
    list.forEach(function (node, i) {
      var on = i === activeIndex;
      node.classList.toggle('is-active', on);
      node.setAttribute('aria-selected', on ? 'true' : 'false');
      if (on) node.scrollIntoView({ block: 'nearest' });
    });
  }

  function open() {
    var node = root();
    if (!node) return;
    lastFocused = document.activeElement;
    node.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    loadIndex().then(function () {
      var input = el('bp-search-input');
      if (input && input.value) render(input.value, search(input.value));
    });
    var input = el('bp-search-input');
    if (input) { input.focus(); input.select(); }
  }

  function close() {
    var node = root();
    if (!node || node.hidden) return;
    node.hidden = true;
    document.documentElement.style.overflow = '';
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }

  function isOpen() {
    var node = root();
    return !!node && !node.hidden;
  }

  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-bp-search-close]')) {
      e.preventDefault();
      close();
      return;
    }
    if (e.target.closest('.BPNavBarSearch')) {
      e.preventDefault();
      open();
      return;
    }
    var hit = e.target.closest('.BPSearch-hit');
    if (hit) close();
  });

  document.addEventListener('keydown', function (e) {
    var meta = e.metaKey || e.ctrlKey;
    if (meta && (e.key === 'k' || e.key === 'K')) {
      e.preventDefault();
      isOpen() ? close() : open();
      return;
    }
    // `/` is the other conventional shortcut, but only when the reader is not
    // already typing into something.
    if (e.key === '/' && !isOpen() && !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName) && !document.activeElement.isContentEditable) {
      e.preventDefault();
      open();
      return;
    }
    if (!isOpen()) return;

    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIndex + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIndex - 1); }
    else if (e.key === 'Enter') {
      var list = hits();
      if (list[activeIndex]) { e.preventDefault(); list[activeIndex].click(); }
    }
  });

  var debounce;
  document.addEventListener('input', function (e) {
    if (e.target.id !== 'bp-search-input') return;
    var query = e.target.value.trim();
    clearTimeout(debounce);
    debounce = setTimeout(function () {
      loadIndex().then(function () { render(query, search(query)); });
    }, 80);
  });
})();
</script>
