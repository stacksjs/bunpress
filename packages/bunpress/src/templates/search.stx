<div class="BPSearch" id="bp-search" hidden>
  <div class="BPSearch-backdrop" data-bp-search-close></div>
  <div class="BPSearch-panel search-modal" role="dialog" aria-modal="true" aria-label="{{ placeholder }}">
    <div class="BPSearch-inputRow">
      <svg class="BPSearch-inputIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input
        type="search"
        class="BPSearch-input search-input"
        id="bp-search-input"
        placeholder="{{ placeholder }}"
        aria-label="{{ placeholder }}"
        aria-controls="bp-search-results"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <button class="BPSearch-cancel" type="button" data-bp-search-close>Esc</button>
    </div>
    <div class="BPSearch-results" id="bp-search-results" role="listbox" aria-label="Search results"></div>
    <div class="BPSearch-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
      <span><kbd>↵</kbd> to select</span>
      <span><kbd>esc</kbd> to close</span>
    </div>
  </div>
</div>

<style>
.BPSearch {
  position: fixed;
  inset: 0;
  z-index: var(--bp-z-index-search, 200);
  display: flex;
  justify-content: center;
  /* Anchored near the top rather than centred: the results list grows
     downward, and a centred panel would jump as it does. */
  align-items: flex-start;
  padding: 12vh 16px 16px;
}

.BPSearch[hidden] {
  display: none;
}

.BPSearch-backdrop {
  position: absolute;
  inset: 0;
  background-color: rgba(15, 15, 17, 0.55);
  backdrop-filter: blur(2px);
}

.BPSearch-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 640px;
  max-height: 100%;
  overflow: hidden;
  background-color: var(--bp-c-bg);
  border: 1px solid var(--bp-c-divider);
  border-radius: 12px;
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.24);
}

.BPSearch-inputRow {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--bp-c-divider);
}

.BPSearch-inputIcon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  color: var(--bp-c-text-3);
}

.BPSearch-input {
  flex: 1;
  min-width: 0;
  background: transparent;
  border: none;
  outline: none;
  font-family: inherit;
  font-size: 16px;
  color: var(--bp-c-text-1);
}

.BPSearch-input::placeholder {
  color: var(--bp-c-text-3);
}

/* The type=search clear affordance differs per engine and collides with the
   Esc button; the Esc button is the documented way out. */
.BPSearch-input::-webkit-search-cancel-button {
  -webkit-appearance: none;
  appearance: none;
}

.BPSearch-cancel {
  flex-shrink: 0;
  padding: 3px 7px;
  font-family: inherit;
  font-size: 11px;
  font-weight: 600;
  color: var(--bp-c-text-3);
  background-color: var(--bp-c-bg-soft);
  border: 1px solid var(--bp-c-divider);
  border-radius: 5px;
  cursor: pointer;
  transition: color 0.2s, border-color 0.2s;
}

.BPSearch-cancel:hover {
  color: var(--bp-c-text-1);
  border-color: var(--bp-c-text-3);
}

.BPSearch-results {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  padding: 8px;
}

.BPSearch-results:empty {
  display: none;
}

.BPSearch-hit {
  display: block;
  padding: 10px 12px;
  border-radius: 8px;
  text-decoration: none;
  color: inherit;
  border: 1px solid transparent;
}

.BPSearch-hit + .BPSearch-hit {
  margin-top: 2px;
}

.BPSearch-hit:hover,
.BPSearch-hit.is-active {
  background-color: var(--bp-c-default-soft, var(--bp-c-gray-soft));
  border-color: var(--bp-c-divider);
}

.BPSearch-hit-breadcrumb {
  display: block;
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--bp-c-text-3);
  margin-bottom: 2px;
}

.BPSearch-hit-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--bp-c-text-1);
  line-height: 1.4;
}

.BPSearch-hit-text {
  /* Two lines of preview: enough to judge relevance, not enough to turn the
     list into a wall of prose. */
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 2px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--bp-c-text-2);
}

.BPSearch-hit mark {
  padding: 0;
  background: transparent;
  color: var(--bp-c-brand-1);
  font-weight: 700;
}

.BPSearch-empty {
  padding: 28px 16px;
  text-align: center;
  font-size: 14px;
  color: var(--bp-c-text-2);
}

.BPSearch-empty strong {
  color: var(--bp-c-text-1);
  overflow-wrap: anywhere;
}

.BPSearch-footer {
  display: flex;
  gap: 16px;
  padding: 8px 14px;
  border-top: 1px solid var(--bp-c-divider);
  background-color: var(--bp-c-bg-soft);
  font-size: 11px;
  color: var(--bp-c-text-3);
}

.BPSearch-footer kbd {
  display: inline-block;
  min-width: 16px;
  margin-right: 3px;
  padding: 1px 4px;
  font-family: inherit;
  font-size: 10px;
  text-align: center;
  color: var(--bp-c-text-2);
  background-color: var(--bp-c-bg);
  border: 1px solid var(--bp-c-divider);
  border-radius: 4px;
}

/* The documented class names (.search-modal, .search-input, .search-result,
   .search-highlight) are applied alongside the BPSearch-* ones so the CSS in
   the search guide targets real elements instead of dead selectors. */

/* Phones: a centred card wastes the screen and fights the keyboard. */
@media (max-width: 639px) {
  .BPSearch {
    padding: 0;
  }

  .BPSearch-panel {
    max-width: none;
    height: 100%;
    max-height: none;
    border: none;
    border-radius: 0;
  }

  .BPSearch-footer {
    display: none;
  }
}
</style>


<script type="application/json" id="bp-search-config">{!! runtimeConfig !!}</script>
<script>
(function () {
  if (window.__bpSearchBound) return;
  window.__bpSearchBound = true;

  var CONFIG = (function () {
    try { return JSON.parse(document.getElementById('bp-search-config').textContent); }
    catch (_) { return {}; }
  })();

  // A config function arrives as source text (it was written in a build-time
  // module). Compiling it can fail under a strict CSP, so every use falls back
  // to the built-in behaviour rather than breaking search outright.
  function compile(source) {
    if (!source) return null;
    try {
      // eslint-disable-next-line no-new-func
      var fn = new Function('return (' + source + ')')();
      return typeof fn === 'function' ? fn : null;
    } catch (_) {
      return null;
    }
  }

  var customTokenize = compile(CONFIG.tokenizeSource);
  var onSearch = compile(CONFIG.onSearchSource);

  var indexPromise = null;
  var records = [];
  var activeIndex = 0;
  var lastFocused = null;

  function el(id) { return document.getElementById(id); }
  function root() { return el('bp-search'); }

  function loadIndex() {
    if (indexPromise) return indexPromise;
    indexPromise = fetch(CONFIG.indexUrl)
      .then(function (res) { return res.ok ? res.json() : []; })
      .then(function (data) { records = Array.isArray(data) ? data : []; return records; })
      .catch(function () { records = []; return records; });
    return indexPromise;
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escapeRegExp(value) {
    return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  /* Tokenizing and stemming
     ---------------------------------------------------------------------- */

  function defaultTokenize(text) {
    return String(text).toLowerCase().split(/[^a-z0-9]+/).filter(Boolean);
  }

  function tokenize(text) {
    if (!customTokenize) return defaultTokenize(text);
    try {
      var out = customTokenize(String(text));
      return Array.isArray(out) ? out.map(String).filter(Boolean) : defaultTokenize(text);
    } catch (_) {
      return defaultTokenize(text);
    }
  }

  // A light suffix stripper, not a full Porter implementation: it collapses
  // the inflections that actually cost documentation searches hits (plurals,
  // -ing/-ed, -ly) and leaves everything else alone. Over-stemming a technical
  // vocabulary does more harm than the recall it buys.
  function stem(token) {
    if (CONFIG.stemmer !== 'english' || token.length < 4) return token;
    var word = token;
    if (/(sses|ies)$/.test(word)) word = word.slice(0, -2);
    else if (/[^s]s$/.test(word)) word = word.slice(0, -1);
    if (/(ational)$/.test(word)) word = word.slice(0, -5) + 'e';
    else if (/(ing|ed)$/.test(word) && /[aeiouy]/.test(word.replace(/(ing|ed)$/, ''))) {
      word = word.replace(/(ing|ed)$/, '');
      if (/(bb|dd|gg|mm|nn|pp|rr|tt)$/.test(word)) word = word.slice(0, -1);
    }
    if (/ly$/.test(word) && word.length > 4) word = word.slice(0, -2);
    return word || token;
  }

  function prepareTerms(text) {
    var seen = Object.create(null);
    var out = [];
    var tokens = tokenize(text);
    for (var i = 0; i < tokens.length; i++) {
      var value = stem(tokens[i]);
      if (!seen[value]) { seen[value] = true; out.push(value); }
    }
    return out;
  }

  // Bounded edit distance: bail as soon as the length gap alone exceeds the
  // allowance, so a long word never costs a full matrix.
  function withinDistance(a, b, max) {
    if (a === b) return true;
    if (Math.abs(a.length - b.length) > max) return false;

    var previous = [];
    for (var j = 0; j <= b.length; j++) previous[j] = j;

    for (var i = 1; i <= a.length; i++) {
      var current = [i];
      var best = i;
      for (var k = 1; k <= b.length; k++) {
        var cost = a.charAt(i - 1) === b.charAt(k - 1) ? 0 : 1;
        current[k] = Math.min(current[k - 1] + 1, previous[k] + 1, previous[k - 1] + cost);
        if (current[k] < best) best = current[k];
      }
      if (best > max) return false;
      previous = current;
    }
    return previous[b.length] <= max;
  }

  /* Matching
     ---------------------------------------------------------------------- */

  // Field names come from the documented searchFields/boost vocabulary:
  // `title` is the section heading, `headings` the page it sits under,
  // `content` the section prose, `keywords` the frontmatter list.
  function fieldValue(record, field) {
    if (field === 'title') return record.title || '';
    if (field === 'headings') return record.page || '';
    if (field === 'content') return record.text || '';
    if (field === 'keywords') return (record.keywords || []).join(' ');
    return '';
  }

  function prepare(record) {
    if (record.__bp) return record.__bp;
    var prepared = { raw: {}, terms: {} };
    var fields = CONFIG.searchFields || ['title', 'headings', 'content', 'keywords'];
    for (var i = 0; i < fields.length; i++) {
      var field = fields[i];
      var value = fieldValue(record, field);
      prepared.raw[field] = value.toLowerCase();
      prepared.terms[field] = prepareTerms(value);
    }
    Object.defineProperty(record, '__bp', { value: prepared, enumerable: false });
    return prepared;
  }

  // 0 = no match. Higher means a better kind of match, before field weighting.
  function fieldStrength(prepared, field, rawTerm, stemmedTerm) {
    var haystack = prepared.raw[field] || '';
    if (haystack) {
      if (haystack === rawTerm) return 4;
      if (haystack.indexOf(rawTerm) === 0) return 3;
      if (haystack.indexOf(rawTerm) !== -1) return 2;
    }

    var tokens = prepared.terms[field] || [];
    for (var i = 0; i < tokens.length; i++) {
      if (tokens[i] === stemmedTerm) return 2;
    }

    if (CONFIG.fuzzy) {
      for (var j = 0; j < tokens.length; j++) {
        if (withinDistance(tokens[j], stemmedTerm, CONFIG.fuzziness || 1)) return 1;
      }
    }
    return 0;
  }

  function score(record, terms) {
    var prepared = prepare(record);
    var fields = CONFIG.searchFields || ['title', 'headings', 'content', 'keywords'];
    var boost = CONFIG.boost || { title: 10, headings: 5, content: 1 };
    var total = 0;

    for (var t = 0; t < terms.length; t++) {
      var matched = 0;
      for (var f = 0; f < fields.length; f++) {
        var field = fields[f];
        var strength = fieldStrength(prepared, field, terms[t].raw, terms[t].stem);
        if (!strength) continue;
        // keywords are an authoring hint, weighted like a heading.
        var weight = field === 'keywords' ? (boost.headings || 5) : (boost[field] || 1);
        matched += strength * weight;
      }
      // Every term must match somewhere, so a two-word query narrows rather
      // than widens the result set.
      if (!matched) return 0;
      total += matched;
    }

    // Shallower headings are more general destinations, so break ties toward
    // them rather than toward a deeply nested subsection.
    return total + Math.max(0, 6 - (record.level || 6));
  }

  function queryTerms(query) {
    var raw = String(query).toLowerCase().split(/\s+/).filter(Boolean);
    return raw.map(function (term) { return { raw: term, stem: stem(term) }; });
  }

  function search(query) {
    if (query.length < (CONFIG.minQueryLength || 1)) return [];
    var terms = queryTerms(query);
    if (!terms.length) return [];

    var hits = [];
    for (var i = 0; i < records.length; i++) {
      var value = score(records[i], terms);
      if (value > 0) hits.push({ record: records[i], score: value });
    }

    hits.sort(function (a, b) { return b.score - a.score; });
    return hits.slice(0, CONFIG.maxResults || 10).map(function (hit) { return hit.record; });
  }

  /* Rendering
     ---------------------------------------------------------------------- */

  function highlight(escaped, terms) {
    if (!CONFIG.result || !CONFIG.result.highlightMatches) return escaped;
    if (!terms.length) return escaped;
    var pattern = new RegExp('(' + terms.map(function (t) { return escapeRegExp(t.raw); }).join('|') + ')', 'gi');
    return escaped.replace(pattern, '<mark class="search-highlight">$1</mark>');
  }

  // Centre the preview on the first match instead of always showing the
  // opening words, which for a long section rarely contain the query.
  function snippet(text, terms) {
    if (!text) return '';
    var length = (CONFIG.result && CONFIG.result.descriptionLength) || 180;
    var lower = text.toLowerCase();
    var at = -1;
    for (var i = 0; i < terms.length; i++) {
      var found = lower.indexOf(terms[i].raw);
      if (found !== -1 && (at === -1 || found < at)) at = found;
    }
    if (at <= 60) return text.slice(0, length);
    var start = Math.max(0, at - 60);
    return '…' + text.slice(start, start + length);
  }

  function render(query, hits) {
    var results = el('bp-search-results');
    if (!results) return;

    if (!query) { results.innerHTML = ''; return; }

    if (!hits.length) {
      results.innerHTML = '<p class="BPSearch-empty">No results for <strong>' + escapeHtml(query) + '</strong></p>';
      return;
    }

    var terms = queryTerms(query);
    var showPath = !CONFIG.result || CONFIG.result.showPath;
    var showDescription = !CONFIG.result || CONFIG.result.showDescription;

    results.innerHTML = hits.map(function (hit, i) {
      var breadcrumb = (showPath && hit.page && hit.title !== hit.page)
        ? '<span class="BPSearch-hit-breadcrumb">' + escapeHtml(hit.page) + '</span>'
        : '';
      var text = showDescription ? snippet(hit.text, terms) : '';
      return '<a class="BPSearch-hit search-result' + (i === 0 ? ' is-active' : '') + '" role="option"' +
        ' aria-selected="' + (i === 0 ? 'true' : 'false') + '" href="' + escapeHtml(hit.url) + '">' +
        breadcrumb +
        '<span class="BPSearch-hit-title">' + highlight(escapeHtml(hit.title || hit.url), terms) + '</span>' +
        (text ? '<span class="BPSearch-hit-text">' + highlight(escapeHtml(text), terms) + '</span>' : '') +
        '</a>';
    }).join('');
    activeIndex = 0;
  }

  function runSearch(query) {
    return loadIndex().then(function () {
      var hits = search(query);
      render(query, hits);
      // Both an event and the config callback: the event needs no build-time
      // code, the callback matches the documented API.
      document.dispatchEvent(new CustomEvent('bp:search', { detail: { query: query, results: hits } }));
      if (onSearch) {
        try { onSearch(query, hits); }
        catch (err) { console.error('search onSearch handler failed:', err); }
      }
      return hits;
    });
  }

  /* Dialog
     ---------------------------------------------------------------------- */

  function hits() { return Array.prototype.slice.call(document.querySelectorAll('.BPSearch-hit')); }

  function setActive(next) {
    var list = hits();
    if (!list.length) return;
    activeIndex = (next + list.length) % list.length;
    list.forEach(function (node, i) {
      var on = i === activeIndex;
      node.classList.toggle('is-active', on);
      node.setAttribute('aria-selected', on ? 'true' : 'false');
      if (on) node.scrollIntoView({ block: 'nearest' });
    });
  }

  function open() {
    var node = root();
    if (!node) return;
    lastFocused = document.activeElement;
    node.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    var input = el('bp-search-input');
    if (input) {
      input.focus();
      input.select();
      if (input.value) runSearch(input.value.trim());
      else loadIndex();
    }
  }

  function close() {
    var node = root();
    if (!node || node.hidden) return;
    node.hidden = true;
    document.documentElement.style.overflow = '';
    if (lastFocused && lastFocused.focus) lastFocused.focus();
  }

  function isOpen() {
    var node = root();
    return !!node && !node.hidden;
  }

  function matchesShortcut(e) {
    var keys = (CONFIG.shortcuts && CONFIG.shortcuts.keys) || [];
    for (var i = 0; i < keys.length; i++) {
      var combo = keys[i];
      if (e.key.toLowerCase() !== combo.key) continue;
      if (!!combo.meta !== e.metaKey) continue;
      if (!!combo.ctrl !== e.ctrlKey) continue;
      if (!!combo.alt !== e.altKey) continue;
      if (combo.shift && !e.shiftKey) continue;
      return combo;
    }
    return null;
  }

  function isTyping() {
    var active = document.activeElement;
    if (!active) return false;
    return /^(INPUT|TEXTAREA|SELECT)$/.test(active.tagName) || active.isContentEditable;
  }

  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-bp-search-close]')) { e.preventDefault(); close(); return; }
    if (e.target.closest('.BPNavBarSearch')) { e.preventDefault(); open(); return; }
    if (e.target.closest('.BPSearch-hit')) close();
  });

  document.addEventListener('keydown', function (e) {
    if (CONFIG.shortcuts && CONFIG.shortcuts.keyboard !== false) {
      var combo = matchesShortcut(e);
      // A bare printable shortcut like `/` must not hijack typing.
      var bare = combo && !combo.meta && !combo.ctrl && !combo.alt;
      if (combo && !(bare && (isOpen() || isTyping()))) {
        e.preventDefault();
        isOpen() ? close() : open();
        return;
      }
    }

    if (!isOpen()) return;

    // Escape always closes, whatever the shortcut configuration says.
    if (e.key === 'Escape') { e.preventDefault(); close(); }
    else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIndex + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIndex - 1); }
    else if (e.key === 'Enter') {
      var list = hits();
      if (list[activeIndex]) { e.preventDefault(); list[activeIndex].click(); }
    }
  });

  var debounce;
  document.addEventListener('input', function (e) {
    if (e.target.id !== 'bp-search-input') return;
    var query = e.target.value.trim();
    clearTimeout(debounce);
    debounce = setTimeout(function () { runSearch(query); }, 80);
  });

  // Eager loading trades bandwidth for a first search with no wait.
  if (CONFIG.lazy === false) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', loadIndex);
    else loadIndex();
  }
})();
</script>
