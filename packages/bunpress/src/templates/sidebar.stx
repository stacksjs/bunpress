<div class="BPSidebar-backdrop" onclick="toggleSidebar(false)"></div>
<nav class="BPSidebar">
  <div class="sidebar-content">
    {!! sections !!}
  </div>
</nav>

{{-- The two section toggles and the section styles live in this template,
  once, rather than in sidebar-section.stx: a template's script and styles are
  emitted wherever it renders, and a sidebar renders that one for each of its
  sections. --}}
<script>
function toggleSection(section) {
  section.classList.toggle('collapsed');
}
function toggleSidebarGroup(button) {
  var group = button.closest('.BPSidebarGroup');
  if (!group) return;
  var collapsed = group.classList.toggle('collapsed');
  button.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
}

function toggleSidebar(forceState) {
  var sb = document.querySelector('.BPSidebar');
  var bd = document.querySelector('.BPSidebar-backdrop');
  if (!sb) return;
  var nextOpen = typeof forceState === 'boolean' ? forceState : !sb.classList.contains('is-open');
  sb.classList.toggle('is-open', nextOpen);
  if (bd) bd.classList.toggle('is-open', nextOpen);
  document.body.style.overflow = nextOpen ? 'hidden' : '';
}
if (!window.__bpSidebarBound) {
  window.__bpSidebarBound = true;
  // Close drawer when the user clicks a sidebar link on mobile
  document.addEventListener('click', function(e) {
    if (window.matchMedia('(min-width: 960px)').matches) return;
    var a = e.target.closest('.BPSidebar a');
    if (a) toggleSidebar(false);
  });
}
</script>

<style>
.BPSidebar {
  position: fixed;
  top: var(--bp-nav-height, 64px);
  bottom: 0;
  left: 0;
  width: var(--bp-sidebar-width, 272px);
  background-color: var(--bp-sidebar-bg-color, var(--bp-c-bg-alt));
  border-right: 1px solid var(--bp-c-divider);
  overflow-y: auto;
  overflow-x: hidden;
  padding: 24px 0 24px 0;
  z-index: var(--bp-z-index-sidebar, 25);
}

.sidebar-content {
  width: 100%;
}

/* Below 960px the sidebar is a drawer: cap it against the viewport so it never
 * covers the whole screen on a small phone, and leave a visible strip of page
 * behind it as an affordance for tapping out. */
@media (max-width: 959px) {
  .BPSidebar {
    width: min(var(--bp-sidebar-width, 272px), 84vw);
    padding: 16px 0 32px;
  }
}

/* At 960px+ (tablet), position sidebar normally */
@media (min-width: 960px) {
  .BPSidebar {
    left: 0;
    width: var(--bp-sidebar-width, 272px);
  }

  .sidebar-content {
    width: 100%;
    margin-left: 0;
  }
}

/* At 1440px+ (ultra-wide), extend sidebar to fill left margin */
@media (min-width: 1440px) {
  .BPSidebar {
    /* Extend width to include left margin area */
    width: calc((100vw - var(--bp-layout-max-width, 1440px)) / 2 + var(--bp-sidebar-width, 272px));
    /* Padding pushes content to the right position */
    padding-left: calc((100vw - var(--bp-layout-max-width, 1440px)) / 2);
  }

  .sidebar-content {
    width: var(--bp-sidebar-width, 272px);
    margin-left: 0;
  }
}

/* A section of the sidebar (sidebar-section.stx), styled here for the same
   reason its toggles are defined here: once per sidebar, not once per section. */
.sidebar-section {
  margin-bottom: 4px;
  padding-bottom: 4px;
}

.sidebar-section + .sidebar-section {
  border-top: 1px solid var(--bp-c-divider);
  padding-top: 10px;
  margin-top: 10px;
}

.sidebar-section-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 20px 6px 22px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.01em;
  color: var(--bp-c-text-1);
  background: transparent;
  border: none;
  cursor: pointer;
  transition: color 0.25s;
  font-family: inherit;
  text-align: left;
}

.sidebar-section-toggle > span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-section-toggle:hover {
  color: var(--bp-c-brand-1);
}

.sidebar-section-toggle .chevron {
  width: 14px;
  height: 14px;
  color: var(--bp-c-text-3);
  transition: transform 0.2s ease-in-out;
  flex-shrink: 0;
}

.sidebar-items {
  list-style: none;
  margin: 2px 0 0 0;
  padding: 0;
}

/* Animates to the section's own height. A max-height of 1000px cut off any
 * section longer than that, which nested groups make easy to reach. */
.sidebar-items-wrapper {
  display: grid;
  grid-template-rows: 1fr;
  transition: grid-template-rows 0.3s ease-in-out, opacity 0.2s ease-in-out;
  opacity: 1;
}

.sidebar-items-wrapper > .sidebar-items { overflow: hidden; min-height: 0; }

.sidebar-section.collapsed > .sidebar-items-wrapper {
  grid-template-rows: 0fr;
  opacity: 0;
}

.sidebar-section.collapsed > .sidebar-section-toggle .chevron {
  transform: rotate(-90deg);
}

.BPSidebarItem-link {
  display: block;
  /* Indented one step past the section title so the hierarchy reads at a
   * glance, and one more step per nested group; the 2px rail is transparent
   * until active, so the label never shifts sideways when you navigate to it. */
  padding: 6px 20px 6px calc(32px + var(--bp-sidebar-depth, 0) * 14px);
  color: var(--bp-c-text-2);
  text-decoration: none;
  font-size: 14px;
  line-height: 1.5;
  transition: color 0.25s, background-color 0.25s;
  border-left: 2px solid transparent;
  overflow-wrap: anywhere;
}

.BPSidebarItem-link:hover {
  color: var(--bp-c-brand-1);
  background-color: var(--bp-c-default-soft, var(--bp-c-gray-soft));
}

.BPSidebarItem-link.is-active {
  color: var(--bp-c-brand-1);
  font-weight: 600;
  border-left-color: var(--bp-c-brand-1);
}

/* A nested group: its title at the level of its siblings, its items one step
 * further in, folding the way a section does. */
.BPSidebarGroup-head {
  display: flex;
  align-items: center;
}

.BPSidebarGroup-link,
.BPSidebarGroup-text {
  flex: 1;
  min-width: 0;
  padding: 6px 4px 6px calc(32px + var(--bp-sidebar-depth, 0) * 14px);
  color: var(--bp-c-text-1);
  font-size: 14px;
  font-weight: 600;
  line-height: 1.5;
  text-decoration: none;
  border-left: 2px solid transparent;
  overflow-wrap: anywhere;
}

.BPSidebarGroup-link:hover { color: var(--bp-c-brand-1); }
.BPSidebarGroup-link.is-active { color: var(--bp-c-brand-1); border-left-color: var(--bp-c-brand-1); }

.BPSidebarGroup-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 32px;
  height: 32px;
  margin-right: 12px;
  padding: 0;
  color: var(--bp-c-text-3);
  background: transparent;
  border: none;
  border-radius: 6px;
  cursor: pointer;
}

.BPSidebarGroup-toggle:hover { color: var(--bp-c-brand-1); background-color: var(--bp-c-default-soft, var(--bp-c-gray-soft)); }

.BPSidebarGroup-toggle .chevron {
  width: 14px;
  height: 14px;
  transition: transform 0.2s ease-in-out;
}

/* Rows that animate to their content's own height, however long the group:
 * a fixed max-height clipped a long group and lagged on a short one. */
.BPSidebarGroup-items {
  display: grid;
  grid-template-rows: 1fr;
  transition: grid-template-rows 0.25s ease-in-out, opacity 0.2s ease-in-out;
}

.BPSidebarGroup-items > .sidebar-items { overflow: hidden; min-height: 0; margin: 0; }
.BPSidebarGroup.collapsed > .BPSidebarGroup-items { grid-template-rows: 0fr; opacity: 0; }
.BPSidebarGroup.collapsed > .BPSidebarGroup-head .chevron { transform: rotate(-90deg); }

@media (prefers-reduced-motion: reduce) {
  .BPSidebarGroup-items, .BPSidebarGroup-toggle .chevron { transition: none; }
}

/* Larger rows on touch layouts, where the drawer is the primary navigation. */
@media (max-width: 959px) {
  .BPSidebarItem-link {
    padding-top: 9px;
    padding-bottom: 9px;
  }

  .sidebar-section-toggle {
    padding-top: 10px;
    padding-bottom: 10px;
  }
}
</style>
