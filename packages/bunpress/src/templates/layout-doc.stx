<!DOCTYPE html>
<html lang="en" class="{{ htmlClass }}" data-theme-mode="{{ themeMode }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ documentTitle }}</title>
  <meta name="description" content="{{ description }}">
  {!! meta !!}
  <style>
    /* VitePress Theme CSS */
    {!! customCSS !!}
  </style>
</head>
<body>
  <div class="Layout">
    <!-- BPNav - Header -->
    {!! navbar !!}

    <!-- BPSidebar -->
    {!! sidebar !!}

    <!-- BPContent - Main content area -->
    <main class="BPContent BPContent--doc">
      <div class="BPDoc">
        <div class="BPDocContent">
          <article class="bp-doc">
            {!! content !!}
          </article>
          {!! footer !!}
        </div>
      </div>
    </main>

    <!-- BPDocAside - TOC -->
    {!! pageTOC !!}
  </div>

  <!-- Search overlay -->
  {!! search !!}
</body>
</html>
