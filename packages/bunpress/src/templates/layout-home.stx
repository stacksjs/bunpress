<!DOCTYPE html>
<html lang="{{ lang }}" class="{{ htmlClass }}" data-theme-mode="{{ themeMode }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ documentTitle }}</title>
  <meta name="description" content="{{ description }}">
  {!! meta !!}
  <style>
    /* VitePress Theme CSS */
    {!! customCSS !!}
  </style>
</head>
<body>
  <div class="Layout">
    <!-- BPNav - Header -->
    {!! navbar !!}

    <main class="BPHome">
      {!! content !!}
      {!! footer !!}
    </main>
  </div>

  <!-- Search overlay -->
  {!! search !!}
</body>
</html>
